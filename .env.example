# VAS Enterprise Accounting Engine Configuration
# Copy this file to .env and adjust variables as needed

# Secret key used for signing and verifying Bearer JWT tokens (minimum 32 characters)
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars

# Server listening configuration
PORT=3000
HOST=127.0.0.1

# Database and disaster recovery paths
DATABASE_PATH=accounting.db
BACKUP_DIR=./backups

# Log verbosity filter (trace, debug, info, warn, error)
LOG_LEVEL=info

# Directory where persistent logs (application, crash dumps, startup errors) are stored
LOG_DIR=./logs

# Console logging format style: pretty (multi-line, default) or compact (single-line)
LOG_FORMAT=pretty

